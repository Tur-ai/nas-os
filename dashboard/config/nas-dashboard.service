[Unit]
Description=NAS-OS Control Deck (dashboard web)
After=network.target

[Service]
User=nasdash
ExecStart=/usr/bin/python3 /opt/nas-dashboard/server.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
